# agents-gateway Production Environment Configuration
# Copy this file and fill in your values

# =============================================================================
# Database Configuration
# =============================================================================
DB_USER=your_db_user
DB_PASS=your_db_password
DB_HOST=your_db_host
DB_PORT=5432
DB_DATABASE=agents_gateway

# =============================================================================
# External Services
# =============================================================================
# Prompts Service URL
SERVICE_PROMPTS=https://your-prompts-service.run.app

# Google API Key (for Gemini models)
GOOGLE_API_KEY=your_google_api_key

# =============================================================================
# Vector Database (Qdrant)
# =============================================================================
QDRANT_URL=https://your-qdrant-instance.cloud
QDRANT_PORT=443
QDRANT_API_KEY=your_qdrant_api_key

# =============================================================================
# Security
# =============================================================================
# Token encryption key (base64 Fernet key)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_TOKEN_ENC_KEY=your_fernet_key_here

# =============================================================================
# Monitoring & Logging (Optional)
# =============================================================================
BETTERSTACK_SOURCE_TOKEN=your_betterstack_token
BETTERSTACK_HOST=https://in.logs.betterstack.com

# =============================================================================
# Environment
# =============================================================================
ENVIRONMENT=production

# =============================================================================
# GCP Configuration (for deployment workflows)
# =============================================================================
GCP_PROJECT_ID=your-gcp-project-id
GCP_SERVICE_ACCOUNT=your-service-account@your-project.iam.gserviceaccount.com
VPC_CONNECTOR=your-vpc-connector  # Optional, remove if not using VPC